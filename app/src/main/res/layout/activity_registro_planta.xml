<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente">

    <!-- Permite desplazarse si el contenido no cabe en pantalla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tarjeta del formulario de la planta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:background="@drawable/card_login"
            android:padding="28dp"
            android:elevation="8dp">

            <!-- Encabezado del formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/card_login">

                <TextView
                    android:id="@+id/tvTituloFormulario"
                    android:layout_width="189dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:text="Nueva Planta"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:background="@drawable/helecho" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de planta"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Selector del tipo de planta -->
            <Spinner
                android:id="@+id/spTipoPlanta"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/card_login"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Campo del nombre de la planta -->
            <EditText
                android:id="@+id/etNombrePlanta"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nombre de la planta"
                android:inputType="text"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <!-- Campo de fecha de siembra (abre un calendario) -->
            <EditText
                android:id="@+id/etFechaSiembra"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Fecha de siembra"
                android:focusable="false"
                android:clickable="true"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

        <!-- Casilla para mostrar u ocultar los campos opcionales -->
        <CheckBox
            android:id="@+id/cbMostrarOpcionales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar campos opcionales"
            android:textColor="@color/texto_oscuro"
            android:layout_marginBottom="12dp" />

        <!-- Contenedor con los campos opcionales -->
        <LinearLayout
            android:id="@+id/contenedorOpcionales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">


            <EditText
                android:id="@+id/etNombreCientifico"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nombre científico (opcional)"
                android:inputType="text"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />



            <EditText
                android:id="@+id/etMetodoSiembra"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Método de siembra (opcional)"
                android:inputType="text"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Observaciones (opcional)"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

            <!-- Botón para guardar la planta -->
            <Button
                android:id="@+id/btnGuardarPlanta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:backgroundTint="@color/verde_oliva"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="10dp" />

            <!-- Botón para cancelar y salir sin guardar -->
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:backgroundTint="@color/terracota"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
