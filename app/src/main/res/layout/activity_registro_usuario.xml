<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_login"
            android:padding="32dp"
            android:elevation="8dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/logo"
                android:contentDescription="Logo de la app" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textColor="@color/texto_oscuro"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Usuario"
                android:inputType="text"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Confirmar contraseña"
                android:inputType="textPassword"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rgRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbGestor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestor Agrícola"
                    android:textColor="@color/texto_oscuro"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbAdministrador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador"
                    android:textColor="@color/texto_oscuro" />

                <RadioButton
                    android:id="@+id/rbConsulta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consulta"
                    android:textColor="@color/texto_oscuro" />

            </RadioGroup>

            <Button
                android:id="@+id/btnRegistrarse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrarse"
                android:backgroundTint="@color/verde_oliva"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvIrLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="¿Ya tenés cuenta? Iniciar sesión"
                android:textColor="@color/terracota"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>