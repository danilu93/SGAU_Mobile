<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente">

    <!-- Permite desplazarse si el contenido no cabe en pantalla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tarjeta del formulario de registro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_login"
            android:padding="32dp"
            android:elevation="8dp">

            <!-- Logo de la aplicación -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/logo"
                android:contentDescription="Logo de la app" />

            <!-- Título del formulario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textColor="@color/texto_oscuro"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Campo de nombre de usuario -->
            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Usuario"
                android:inputType="text"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <!-- Campo de correo electrónico -->
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="12dp" />

            <!-- Campo de contraseña -->
            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="5dp" />

            <!-- Casilla para mostrar u ocultar la contraseña -->
            <CheckBox
                android:id="@+id/cbMostrarContrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar contraseña"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="8dp" />

            <!-- Campo para confirmar la contraseña -->
            <EditText
                android:id="@+id/etConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Confirmar contraseña"
                android:inputType="textPassword"
                android:textColorHint="@color/texto_oscuro"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="5dp" />

            <!-- Casilla para mostrar u ocultar la confirmación -->
            <CheckBox
                android:id="@+id/cbMostrarConfirmacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar confirmación"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Selección del rol del nuevo usuario -->
            <RadioGroup
                android:id="@+id/rgRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbGestor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestor Agrícola"
                    android:textColor="@color/texto_oscuro"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbAdministrador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador"
                    android:textColor="@color/texto_oscuro" />

                <RadioButton
                    android:id="@+id/rbConsulta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consulta"
                    android:textColor="@color/texto_oscuro" />

            </RadioGroup>

            <!-- Botón para registrarse -->
            <Button
                android:id="@+id/btnRegistrarse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrarse"
                android:backgroundTint="@color/verde_oliva"
                android:textColor="#FFFFFF" />

            <!-- Enlace a la pantalla de inicio de sesión -->
            <TextView
                android:id="@+id/tvIrLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="¿Ya tenés cuenta? Iniciar sesión"
                android:textColor="@color/terracota"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
