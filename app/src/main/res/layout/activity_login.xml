<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_login"
        android:padding="32dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/logo"
            android:contentDescription="Logo de la app" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="14dp"
            android:hint="Usuario"
            android:inputType="text"
            android:textColor="@color/texto_oscuro"
            android:textColorHint="@color/texto_oscuro" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="24dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColor="@color/texto_oscuro"
            android:textColorHint="@color/texto_oscuro" />

        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:backgroundTint="@color/verde_oliva"
            android:text="Iniciar sesión"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvIrRegistro"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:text="¿No tenés cuenta? Registrate"
            android:textColor="@color/terracota"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>