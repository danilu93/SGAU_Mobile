<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_login"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombrePlanta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_oscuro"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Guaria Morada" />

        <TextView
            android:id="@+id/tvTipoPlanta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/terracota"
            android:textSize="13sp"
            tools:text="Ornamental" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnVerDetalle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_view"
        android:contentDescription="Ver detalle de la planta" />

    <ImageButton
        android:id="@+id/btnEditarPlanta"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="Editar planta" />

    <ImageButton
        android:id="@+id/btnEliminarPlanta"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Eliminar planta" />

</LinearLayout>