<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:background="@drawable/card_login"
            android:padding="28dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp"
                tools:text="Guaria Morada" />

            <TextView
                android:id="@+id/tvDetalleTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/terracota"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                tools:text="Ornamental" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre científico"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetalleNombreCientifico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="14dp"
                tools:text="Schlumbergera truncata" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de siembra"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetalleFechaSiembra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="14dp"
                tools:text="2026-03-10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Método de siembra"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetalleMetodoSiembra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="14dp"
                tools:text="Trasplante de esqueje" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de registro"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetalleFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="14dp"
                tools:text="2026-01-15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observaciones"
                android:textColor="@color/texto_oscuro"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetalleObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_oscuro"
                android:layout_marginBottom="24dp"
                tools:text="Regar cada 10 días." />

            <Button
                android:id="@+id/btnCerrarDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar"
                android:backgroundTint="@color/verde_oliva"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>